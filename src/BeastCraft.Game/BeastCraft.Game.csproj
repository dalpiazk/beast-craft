<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BeastCraft.Game: the MonoGame code every host shares: the game (BeastCraftGame: the screen
    stack, keyboard, mouse and touch input, the 1080x1920 portrait canvas letterboxed into the
    screen), its screens (Screens/: title, home with the region map, encounter, battle, results,
    modals), the UI toolkit's painter (Ui/), the sprite atlas, sprite renderer and the pixel text,
    and the APK-asset content source. The hosts are thin: src/BeastCraft.Desktop
    (DesktopGL) and src/BeastCraft.Android (MonoGame.Framework.Android) each reference this library
    plus their own MonoGame platform package.

    This is MonoGame's own pattern for shared game code (the 3.8.5 "2D Starter Kit" template's Core
    project): a plain net10.0 class library that compiles against one MonoGame platform package
    with PrivateAssets="All", so the reference never flows to a host: every platform package
    ships the same MonoGame.Framework assembly and API, and each host brings its own at runtime.
    The starter kit compiles against MonoGame.Framework.Native; this compiles against DesktopGL
    instead, which the desktop host restores anyway, so the CI build (Desktop, which builds this)
    downloads nothing new. A library rather than a shared project (.shproj/.projitems) because it
    compiles once, is format-checked and built by CI as a normal csproj, and keeps the hosts'
    project files trivial.

    net10.0 and C# 9, like the desktop host.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RootNamespace>BeastCraft.Game</RootNamespace>
    <AssemblyName>BeastCraft.Game</AssemblyName>
  </PropertyGroup>

  <!--
    The frame-time overlay (#64, Diagnostics/PerfOverlay.cs) is compiled into Debug builds. A Release build
    gets it only with -p:PerfOverlay=true, to measure optimised code (docs/design/performance.md); a
    shipping build never has it.
  -->
  <PropertyGroup Condition="'$(PerfOverlay)' == 'true'">
    <DefineConstants>$(DefineConstants);PERF_OVERLAY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The UI font's rasteriser (TtfText): FontStashSharp, Zlib licence (with StbTrueTypeSharp and
      StbImageSharp, MIT/Unlicense, and Cyotek.Drawing.BitmapFont, MIT); see THIRD-PARTY-NOTICES.md.
      It references MonoGame.Framework but ships none, so each host's own platform package serves it;
      unlike the MonoGame reference it must flow to the hosts (they load it at run time).
    -->
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.1" />
    <!--
      The music stream's OGG Vorbis decoder (MonoGameMusicPlayer): NVorbis, MIT (see THIRD-PARTY-NOTICES.md).
      The version MonoGame's own packages resolve, referenced here so it flows to every host.
    -->
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeastCraft.Core\BeastCraft.Core.csproj" />
    <ProjectReference Include="..\BeastCraft.Presentation\BeastCraft.Presentation.csproj" />
  </ItemGroup>

</Project>
