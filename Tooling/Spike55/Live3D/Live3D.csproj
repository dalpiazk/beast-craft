<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike #55, fourth pass: real-time 3D in MonoGame (DesktopGL), standalone from the game — NOT
    added to BeastCraft.slnx and does NOT touch src/, so CI is unaffected by this spike. Mirrors
    src/BeastCraft.Desktop's TargetFramework and MonoGame.Framework.DesktopGL package version so the
    comparison is apples-to-apples.

    Loads Content/model/griffin_live.glb (a Blender-authored, skinned + idle/move-animated
    low-poly Griffin, exported from the spike's pass-3 Meshy remesh — see
    Tooling/Spike55/blender_export_live.py) at runtime with SharpGLTF (MIT licence; SharpGLTF.Core
    only — this project hand-rolls CPU skinning and animation sampling directly against the glTF
    schema rather than using SharpGLTF.Runtime's scene-graph helper, so Runtime is not referenced).
    The only MGCB-built content is the custom toon/outline effect (Content/Effects/Toon.fx); the GLBs
    and backdrop PNG are read as plain files at runtime (Texture2D.FromStream / File.ReadAllBytes),
    same convention as BeastCraft.Desktop's own content loading.

    See Tooling/Spike55/README.md for build/run/bench commands, licence notes and how the assets were built.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RootNamespace>BeastCraft.Spike55.Live3D</RootNamespace>
    <AssemblyName>Live3D</AssemblyName>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
    <!-- Standalone spike: not part of BeastCraft.slnx, no ProjectReference to src/ or Tooling/. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
    <!-- MIT licence (https://github.com/vpenades/SharpGLTF) — see Tooling/Spike55/README.md's
         "Licences" section for the full notice this project ships. -->
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content pipeline: only the toon/outline effect is MGCB-built; everything else (GLBs, backdrop
         PNG) is read as a plain file at runtime, same convention as BeastCraft.Desktop. -->
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <None Include="Content\model\griffin_live.glb" Link="Content\model\griffin_live.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- Anim-pilot griffin (issue #68, Tooling/Animation): the 25-bone, three-clip (Idle/Move/Attack)
         skinned + animated GLB, loaded instead of griffin_live.glb when the pilot sequence mode is
         requested (see Game1.LoadContent). -->
    <None Include="Content\model\griffin_anim.glb" Link="Content\model\griffin_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- Round 15: griffin_anim.glb's sidecar event-marker JSON (export_glb.py writes it alongside the
         GLB; see Game1.LoadPilotEventMarkers and Tooling/Animation/anim/keyed.py's EVENT_MARKERS).
         Optional at runtime (LoadPilotEventMarkers tolerates a missing file), but ships here so the
         pilot sequence mode can log marker crossings out of the box. -->
    <None Include="Content\model\griffin_anim_events.json" Link="Content\model\griffin_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\crest_alt.glb" Link="Content\model\crest_alt.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\content\art\backdrops\r01\sun0\medium.png" Link="Content\backdrop.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fifth pass fix round (swarm via GPU skinning, battle mode only): the real, rigged Swarmling,
         a skinned + idle/move-animated GLB, loaded with SharpGLTF exactly like the Griffin (see
         Tooling/Spike55/blender_export_live_swarmling.py). Replaces the earlier procedural
         placeholder's custom Content/swarm/*.bin format. -->
    <None Include="Content\model\swarmling_live.glb" Link="Content\model\swarmling_live.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- v18 wingless quadrupeds (Tooling/Animation/README.md): Golem, Kirin, Tarasque, Basilisk, rigged
         and animated through the same pipeline as the Griffin, loaded via the "pilot-model" NAME option
         alongside "pilot-sequence" mode (see Game1.LoadContent/LaunchOptions). Each GLB has its own
         sidecar event-marker JSON, same convention as griffin_anim_events.json above. -->
    <None Include="Content\model\golem_anim.glb" Link="Content\model\golem_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\golem_anim_events.json" Link="Content\model\golem_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\kirin_anim.glb" Link="Content\model\kirin_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\kirin_anim_events.json" Link="Content\model\kirin_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\tarasque_anim.glb" Link="Content\model\tarasque_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\tarasque_anim_events.json" Link="Content\model\tarasque_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\basilisk_anim.glb" Link="Content\model\basilisk_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\basilisk_anim_events.json" Link="Content\model\basilisk_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- v19 birds (Tooling/Animation/README.md): Phoenix and Thunderbird, both hovering fliers,
         rigged and animated through the new winged_biped template. Same pilot-model + sidecar
         convention as the v18 quadrupeds above; the events sidecar also carries the "hover" block
         (lift offset blended across crossfades, KO exempt) that LaunchOptions/Game1 read. -->
    <None Include="Content\model\phoenix_anim.glb" Link="Content\model\phoenix_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\phoenix_anim_events.json" Link="Content\model\phoenix_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\thunderbird_anim.glb" Link="Content\model\thunderbird_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\thunderbird_anim_events.json" Link="Content\model\thunderbird_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- v20 (Tooling/Animation/README.md): Frost Wyrm (quadruped template), Treant (new biped_arms
         template, then producer-approved mesh surgery, see Tooling/Animation/meshfix/) and Leviathan
         (new serpent template, slither locomotion). Same pilot-model + sidecar convention as above.
         phoenix_anim.glb above is also replaced here with the talon-hole-filled GLB (animation data
         unchanged; see Tooling/ArtLab/provenance/meshy-01a10d81-69f1-725f-9860-2c1750478fcb.md's
         2026-10-06 note). -->
    <None Include="Content\model\frost_wyrm_anim.glb" Link="Content\model\frost_wyrm_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\frost_wyrm_anim_events.json" Link="Content\model\frost_wyrm_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\treant_anim.glb" Link="Content\model\treant_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\treant_anim_events.json" Link="Content\model\treant_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\leviathan_anim.glb" Link="Content\model\leviathan_anim.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\model\leviathan_anim_events.json" Link="Content\model\leviathan_anim_events.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
