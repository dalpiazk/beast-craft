<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runner for the Beast Craft test suite (NUnit).

        dotnet test Tooling/EditModeTests

    References the game runtime, src/BeastCraft.Core, and the presentation layer,
    src/BeastCraft.Presentation, and compiles the suite's sources: the tests
    under Tests/ (moved here from the retired Unity project), the golden-value tests beside this file (Goldens/) and the presentation tests
    (Presentation/).

    CI runs it (.github/workflows/ci.yml: a dotnet format check, then dotnet test in Release), as a
    final gate only: run it locally before pushing (Actions budget).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The runtime is written for C# 9; the tests are held to the same version. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>BeastCraft.Tests.EditMode</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BeastCraft.Core\BeastCraft.Core.csproj" />
    <!-- The engine-neutral presentation layer (content loading, hex layout, VFX timeline). -->
    <ProjectReference Include="..\..\src\BeastCraft.Presentation\BeastCraft.Presentation.csproj" />
  </ItemGroup>

  <!--
    Paths are relative to this csproj: Tooling/EditModeTests -> repo root is two levels up. The
    data JSON files are not copied: the tests find them by walking up from the output directory.
  -->
  <ItemGroup>
    <!-- The main suite (the former Unity EditMode tests). -->
    <Compile Include="Tests\**\*.cs" />
    <!-- Golden-value tests owned by this runner (see Goldens/GoldenFiles.cs). -->
    <Compile Include="Goldens\*.cs" />
    <!-- Tests of src/BeastCraft.Presentation and the VFX library (Core's BeastCraft.Vfx). -->
    <Compile Include="Presentation\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- NUnit 3 (the Unity Test Framework's version, which the suite was written against). -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
