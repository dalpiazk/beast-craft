<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CI compile/format harness for the Beast Craft Unity scripts.

    This project owns no source of its own. It pulls the real game scripts in by glob and compiles
    them against UnityStub, which fakes just enough of the UnityEngine API surface for the compiler.
    That gives CI a genuine compile-error check (and a `dotnet format` target) without needing a
    Unity Editor install or a UNITY_LICENSE secret.

    It is NOT a build of the game and is no substitute for opening the project in Unity.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6000.0 ships C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- No first-party sources live beside this csproj; everything is pulled in explicitly below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>BeastCraft</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityStub\UnityStub.csproj" />
  </ItemGroup>

  <!--
    Paths are relative to this csproj: Tooling/CiStubs/CiLint -> repo root is three levels up.
    The Unity Editor importers (Scripts/Editor) are no longer compiled: the content types they
    build are plain C# now, so they only ever worked inside the retired Unity project.
  -->
  <ItemGroup>
    <Compile Include="..\..\..\BeastCraft\Assets\_Project\Scripts\Runtime\**\*.cs">
      <Link>GameSource\Runtime\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
