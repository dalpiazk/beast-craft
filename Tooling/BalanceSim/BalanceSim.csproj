<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless balance simulator for Beast Craft. LOCAL-ONLY TOOLING: not a CI job, never shipped,
    never referenced by game code. See README.md beside this file.

    It runs the real battle code: the engine-neutral game runtime, src/BeastCraft.Core, by
    ProjectReference.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 is the installed LTS SDK. BeastCraft.Core targets netstandard2.1. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The game runtime is written for C# 9; the simulator's own sources are held to the same
         version. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RootNamespace>BeastCraft.Tooling.BalanceSim</RootNamespace>
    <AssemblyName>BalanceSim</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Server GC: every core allocates battle state flat out, and per-core heaps cut the default
         run's GC pauses (about 8700 gen0 collections with workstation GC, 1800 with this) and its
         wall clock by about a sixth. Measured; see README.md, "Performance". -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BeastCraft.Core\BeastCraft.Core.csproj" />
  </ItemGroup>

</Project>
