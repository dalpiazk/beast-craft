# ---------------------------------------------------------------------------
# Beast Craft .gitignore
#
# The game is plain .NET (src/, Tooling/); every *.csproj is hand-written and
# committed. Patterns are unanchored so they match at any depth.
# ---------------------------------------------------------------------------

# .NET build output (src/*, Tooling/BalanceSim, Tooling/EditModeTests)
[Bb]in/
[Oo]bj/
TestResults/

# Visual Studio / Rider / VS Code caches and per-user files
.vs/
.vscode/
.idea/
.gradle/
*.suo
*.user
*.userprefs
*.tmp
*.pdb
*.VC.db

# Builds / packaged output (the Android host's APKs/AABs land under bin/, but
# never commit one that was copied elsewhere either)
*.apk
*.aab
*.app
*.ipa
*.xcarchive

# ---------------------------------------------------------------------------
# Offline asset pipeline (Pipeline/) -- local secrets, venvs, scratch output
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
Pipeline/**/out/
Pipeline/**/tmp/
Pipeline/**/_scratch/

# ---------------------------------------------------------------------------
# Tooling/PixelArt -- local previews (the game PNGs it writes to
# content/art/pixel are committed). Its .venv is caught by the `.venv/` rule
# above.
# ---------------------------------------------------------------------------
Tooling/PixelArt/preview/

# ---------------------------------------------------------------------------
# Tooling/ArtLab -- models, the venv and outputs live outside the repo
# (%LOCALAPPDATA%\BeastCraftArtLab); these catch a lab folder pointed inside it.
# ---------------------------------------------------------------------------
Tooling/ArtLab/models/
Tooling/ArtLab/work/
Tooling/ArtLab/out/
*.safetensors
*.ckpt

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Claude Code local state (agent worktrees, settings) -- never committed
# ---------------------------------------------------------------------------
.claude/
