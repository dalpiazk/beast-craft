# ---------------------------------------------------------------------------
# Unity .gitignore
#
# Patterns are intentionally UNANCHORED (no leading slash) so they match at any
# depth -- this repo keeps the Unity project in BeastCraft/, so `[Ll]ibrary/`
# correctly matches `BeastCraft/Library/`.
# ---------------------------------------------------------------------------

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Never ignore Asset Store Tools plugins
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code cache directories
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Visual Studio / MonoDevelop generated project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds / packaged output
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.xcarchive

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ss]erver[Dd]ata/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Offline asset pipeline (Pipeline/) -- local secrets, venvs, scratch output
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
Pipeline/**/out/
Pipeline/**/tmp/
Pipeline/**/_scratch/

# ---------------------------------------------------------------------------
# Tooling/CiStubs -- the CI compile/format harness.
#
# These are hand-written, permanent projects (NOT Unity-generated), so they
# must survive the blanket `*.csproj` rule above. Their build output is not
# covered by the Unity rules -- `[Oo]bj/` already catches obj/, but bin/ needs
# an explicit entry.
# ---------------------------------------------------------------------------
!Tooling/CiStubs/**/*.csproj
Tooling/CiStubs/**/bin/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
