  "Lore": [
    {
      "LoreId": "affinity_lore_phoenix",
      "Title": "Phoenix at Ease",
      "Text": "It naps in the warmest patch of sun it can find, feathers banked low like embers."
    },
    {
      "LoreId": "affinity_lore_leviathan",
      "Title": "Leviathan at Ease",
      "Text": "It curls loosely by the water's edge now, unbothered when you sit close."
    },
    {
      "LoreId": "affinity_lore_golem",
      "Title": "Golem at Ease",
      "Text": "Moss has started to soften its shoulders. It leans into a scratch like a boulder settling."
    },
    {
      "LoreId": "affinity_lore_griffin",
      "Title": "Griffin at Ease",
      "Text": "It brings you the shiniest pebble it can find and waits, very pleased with itself."
    },
    {
      "LoreId": "affinity_lore_thunderbird",
      "Title": "Thunderbird at Ease",
      "Text": "The air hums faintly when it is glad to see you, a small private thunder."
    },
    {
      "LoreId": "affinity_lore_frost_wyrm",
      "Title": "Frost Wyrm at Ease",
      "Text": "Frost patterns bloom gently on the ground where it rests beside you."
    },
    {
      "LoreId": "affinity_lore_treant",
      "Title": "Treant at Ease",
      "Text": "New leaves have budded along one arm. It holds very still so you can look."
    },
    {
      "LoreId": "affinity_lore_tarasque",
      "Title": "Tarasque at Ease",
      "Text": "Its plates click together in a slow, contented rhythm when you visit."
    },
    {
      "LoreId": "affinity_lore_kirin",
      "Title": "Kirin at Ease",
      "Text": "It leaves a faint trail of soft light on the grass wherever it has walked."
    },
    {
      "LoreId": "affinity_lore_basilisk",
      "Title": "Basilisk at Ease",
      "Text": "It no longer looks away when you meet its eyes. That took a while."
    },
    {
      "LoreId": "gift_lore_wander",
      "Title": "A Wandering Gift",
      "Text": "Every beast seems to bring something different when it is happy \u2014 a feather, a pebble, a leaf held very carefully."
    },
    {
      "LoreId": "gift_lore_hearth",
      "Title": "Small Kindnesses",
      "Text": "A fed, played-with beast starts leaving little things by the gate, as if trading favours back."
    },
    {
      "LoreId": "gift_lore_season",
      "Title": "What the Season Brings",
      "Text": "Some gifts only turn up after a beast has been settled in a good while. Patience, it seems, is its own reward."
    }
  ],
