  "Stories": [
    {
      "StoryId": "story_whispering_hollow",
      "Text": "The scouts found a hollow tree that hums faintly when the wind turns. They left it exactly as they found it.",
      "CodexCategory": "Wilds"
    },
    {
      "StoryId": "story_sunken_shoal",
      "Text": "At low tide a shoal appears, ringed in shells no one has named yet. The scouts sketched a few before the water returned.",
      "CodexCategory": "Wilds"
    },
    {
      "StoryId": "story_frostglass_ridge",
      "Text": "Ice on the ridge has grown so clear you can see frozen leaves inside it, perfectly preserved from some older autumn.",
      "CodexCategory": "Wilds"
    },
    {
      "StoryId": "story_nearby_meadow",
      "Text": "A meadow just past the treeline is thick with wildflowers that close up tight whenever a shadow passes over.",
      "CodexCategory": "Old Roads"
    },
    {
      "StoryId": "story_old_orchard",
      "Text": "The old orchard's trees are gnarled and half-wild now, but they still fruit every year, right on schedule.",
      "CodexCategory": "Old Roads"
    },
    {
      "StoryId": "story_river_bend",
      "Text": "Where the river bends there is a quiet pool the current never seems to disturb, however hard it rains upstream.",
      "CodexCategory": "Old Roads"
    },
    {
      "StoryId": "story_quiet_ruins",
      "Text": "Something was built here once, long enough ago that moss has claimed most of the walls. It still feels cared for.",
      "CodexCategory": "Old Roads"
    },
    {
      "StoryId": "story_far_ridge_trail",
      "Text": "The trail crests a ridge with a view of country none of the maps quite agree on. The scouts added their own notes.",
      "CodexCategory": "Old Roads"
    }
  ]
}
